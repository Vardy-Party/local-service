{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [],
  "ScrapeHealth": {
    "AllowedApiHosts": []
  },
  "Auth0": {
    "Domain": "",
    "Audience": "",
    "ClaimNamespace": "",
    "RequiredRoleClaimType": "",
    "RequiredRole": "stream-viewer",
    "RequiredPermission": "read:streams"
  },
  "Discovery": {
    "ServiceName": "VardyParty Local Service",
    "ManageFirewallRules": true
  },
  "Playwright": {
    "BrowsersPath": "./browsers",
    "Headless": true,
    "IncludeScreenshots": false
  },
  "Chrome": {
    "Headless": true,
    "ExecutablePath": null
  }
}
