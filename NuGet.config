<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- <clear /> drops parent/user sources; CI writes packageSourceCredentials for
         github-vardy-party into this file at runtime (see .github/workflows/ci.yml).
         No local folder source here: committed pins must restore from the feed alone.
         For unreleased Strategies packs use a git-ignored NuGet.local.config
         (DEVELOPMENT.md, "Testing unreleased Strategies packages"). -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github-vardy-party" value="https://nuget.pkg.github.com/Vardy-Party/index.json" />
  </packageSources>
</configuration>
