# Copy to .env (gitignored) in the repo root.
# Sync Actions secrets: pwsh scripts/sync-github-secrets-from-env.ps1
#
# Required for Main Packaging (Auth0 injected into appsettings before publish)
# and for from-source runs (scripts/run-from-source.ps1|.sh load these into the process):
# AUTH0_DOMAIN must be the custom login/JWKS host (same as Worker AUTH0_DOMAIN),
# not the legacy *.auth0.com tenant when tokens use the custom iss.
# AUTH0_DOMAIN=your-custom-auth-host.example
# AUTH0_AUDIENCE=https://your-api-audience
#
# Optional (same values as Client / Worker when used):
# AUTH0_CLAIM_NAMESPACE=
# AUTH0_REQUIREDROLECLAIMTYPE=
# AUTH0_REQUIREDROLE=stream-viewer
# AUTH0_REQUIRED_PERMISSION=read:streams
#
# Scrape-health HTTPS allowlist (comma-separated hosts or .suffix entries).
# Merged into ScrapeHealth:AllowedApiHosts on publish/install. Audience host is
# also allowed when AUTH0_AUDIENCE is an https URI — but that alone is NOT enough
# when Client HeadlessBaseUrl / API host differs (e.g. preview Worker ≠ audience).
# List every host the Client may send as X-VP-Api-Base-Url.
# SCRAPE_HEALTH_ALLOWED_API_HOSTS=.example.test,api.example.test
#
# MSIX signing (Windows packaging):
# WINDOWS_CERT_BASE64=
# WINDOWS_CERT_PASSWORD=
#
# GitHub Packages restore (CI + local run-from-source / ensure-github-packages-auth.ps1):
# Classic PAT with read:packages, SSO-authorized for the Vardy-Party org.
# Source key in NuGet.config is github-vardy-party (name must match credentials).
# NUGET_GITHUB_TOKEN=
# NUGET_GITHUB_USERNAME=
